{
  "name": "decide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/unpack.mjs",
    "build": "node scripts/fetch-public.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test tests/e2e",
    "e2e:shots": "playwright test tests/shots",
    "smoke": "node scripts/smoke-order.mjs",
    "check:bundle": "node scripts/check-api-bundle.mjs",
    "icons": "node scripts/build-icons.mjs",
    "replay": "vitest run tests/unit/discovery-replay.test.ts",
    "probe:lanes": "node scripts/probe-lanes.mjs",
    "taste": "node scripts/taste-judge.mjs",
    "lint": "eslint src api tests/unit",
    "lint:fix": "eslint src api tests/unit --fix",
    "prepare": "husky",
    "test:mutants": "stryker run"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "api/**/*.ts": [
      "eslint --fix"
    ],
    "tests/unit/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
